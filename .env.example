# Copy to .env and fill in. Everything here has a default that works for a look around
# and none that should survive contact with a real municipality.

# The shared secret a caller sends in X-Api-Key. Leave empty and one is generated at
# startup and printed once.
API_KEY=

# What resident ids are named after in logs. Leave empty and a new one is generated every
# restart, which is safe and makes yesterday's logs unfollowable.
PSEUDONYM_SECRET=

# The database. The compose file builds a Postgres alongside; point these somewhere else
# to use one you already have.
DB_NAME=agent
DB_USERNAME=agent
DB_PASSWORD=a-development-password

# The model. With no key the keyword stand-in answers and nothing is billed; set both to
# put a real one behind the classifier.
PROFILES=
ANTHROPIC_API_KEY=

# Tracing. Bring the collector up with: docker compose --profile tracing up
OTLP_ENABLED=false

# Logging: ecs for one JSON object per line, empty for something a person can read.
LOG_FORMAT=ecs

PORT=8080
